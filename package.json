{
  "name": "@moku-labs/editor",
  "version": "0.9.4",
  "description": "Editor, devtools and MCP layer for @moku-labs/game: one registry of sources and commands, panels in an in-game overlay and a dev-server tools page.",
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./agent": {
      "types": "./dist/agent.d.mts",
      "default": "./dist/agent.mjs"
    },
    "./agent/page": {
      "types": "./dist/agent-page.d.mts",
      "default": "./dist/agent-page.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./tools": {
      "types": "./dist/tools.d.mts",
      "default": "./dist/tools.mjs"
    }
  },
  "bin": {
    "moku-editor": "./dist/bin.mjs"
  },
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moku-labs/editor.git"
  },
  "homepage": "https://github.com/moku-labs/editor#readme",
  "bugs": {
    "url": "https://github.com/moku-labs/editor/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint --fix .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:unit": "bun --bun vitest run --project unit",
    "test:integration": "bun --bun vitest run --project integration",
    "test:coverage": "bun --bun vitest run --project unit --project integration --coverage",
    "build": "tsdown && bun run build:tools",
    "build:tools": "bun scripts/build-tools.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "validate": "publint && attw --pack . --profile esm-only",
    "release:setup": "moku-release setup",
    "release:doctor": "moku-release doctor",
    "release": "moku-release"
  },
  "peerDependencies": {
    "@moku-labs/common": "^0.3.4",
    "@moku-labs/core": "^1.7.1",
    "@moku-labs/game": ">=0.10.0",
    "typescript": ">=5.5"
  },
  "dependencies": {
    "elkjs": "0.12.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.3",
    "@arethetypeswrong/core": "0.18.3",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.4.16",
    "@moku-labs/ci": "1.3.0",
    "@moku-labs/common": "0.3.4",
    "@moku-labs/core": "1.7.1",
    "@moku-labs/game": "0.10.0",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.3.14",
    "@vitest/coverage-istanbul": "4.0.18",
    "eslint": "9.39.3",
    "eslint-config-biome": "2.1.3",
    "eslint-plugin-jsdoc": "62.6.0",
    "eslint-plugin-sonarjs": "4.0.0",
    "eslint-plugin-unicorn": "63.0.0",
    "globals": "17.4.0",
    "happy-dom": "20.14.5",
    "jiti": "2.6.1",
    "lefthook": "2.1.1",
    "publint": "0.3.21",
    "tsdown": "0.22.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.0",
    "vitest": "4.0.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
